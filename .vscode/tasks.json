{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Yoink: sandbox",
            "type": "process",
            "command": "${workspaceFolder}/scripts/sandbox.sh",
            "args": ["--pypi-yt-dlp"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Yoink: sandbox (clean)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/sandbox.sh",
            "args": ["--pypi-yt-dlp", "--clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Tests",
            "type": "process",
            "command": "uv",
            "args": ["run", "pytest"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "bash scripts/build.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build (release)",
            "type": "shell",
            "command": "bash scripts/build.sh --release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build (Windows)",
            "type": "shell",
            "command": "scripts\\build.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build (release, Windows)",
            "type": "shell",
            "command": "scripts\\build.bat --release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
